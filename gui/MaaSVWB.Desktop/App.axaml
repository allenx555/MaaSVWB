<Application
    x:Class="MaaSVWB.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#F5F7FA" />
      <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DDE3EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3C8D91" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#31777B" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#EEF3F4" />
      <Setter Property="Foreground" Value="#35565A" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="16,9" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#263238" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#76838F" />
    </Style>

    <Style Selector="TabControl.mainTabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="24,0,0,2" />
    </Style>
    <Style Selector="TabControl.mainTabs /template/ TabStripItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="34,15" />
      <Setter Property="Foreground" Value="#4C5964" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.mainTabs /template/ TabStripItem:selected">
      <Setter Property="Foreground" Value="#3C8D91" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBox.logBox">
      <Setter Property="Background" Value="#182126" />
      <Setter Property="Foreground" Value="#D8E2E6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBox.logBox:pointerover">
      <Setter Property="Background" Value="#182126" />
      <Setter Property="Foreground" Value="#D8E2E6" />
    </Style>
    <Style Selector="TextBox.logBox:focus">
      <Setter Property="Background" Value="#182126" />
      <Setter Property="Foreground" Value="#D8E2E6" />
    </Style>
    <Style Selector="TextBox.logBox:focus-within">
      <Setter Property="Background" Value="#182126" />
      <Setter Property="Foreground" Value="#D8E2E6" />
    </Style>
    <Style Selector="TextBox.logBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#182126" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.logBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#182126" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.logBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#182126" />
      <Setter Property="BorderBrush" Value="#3C8D91" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Styles>
</Application>
