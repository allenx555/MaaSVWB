<Window
    x:Class="MaaSVWB.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:MaaSVWB.Desktop.Views"
    Icon="/Assets/AppIcon.ico"
    Title="MaaSVWB"
    Width="1120"
    Height="760"
    MinWidth="900"
    MinHeight="620"
    WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="72,*">
    <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid ColumnDefinitions="Auto,32,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center">
          <TextBlock FontSize="21" FontWeight="Bold" Foreground="#2F6F73" Text="MaaSVWB" />
          <TextBlock Classes="caption" Text="影之诗：超凡世界助手" />
        </StackPanel>
        <Border Grid.Column="1" Width="1" Height="36" Background="#DDE3EA" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Classes="caption" Text="安卓模拟器" />
          <ComboBox Width="230"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding DeviceSerial}" />
        </StackPanel>
        <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="#607079" Text="{Binding StatusText}" />
        <Button Grid.Column="5" Classes="secondary" Command="{Binding RefreshDevicesCommand}" Content="刷新设备" />
        <Button Grid.Column="6" Classes="primary" Command="{Binding TestConnectionCommand}" Content="测试连接" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Classes="mainTabs">
      <TabItem Header="盘面解密">
        <views:TaskTabView DataContext="{Binding Puzzle}" />
      </TabItem>
      <TabItem Header="对战教程">
        <views:TaskTabView DataContext="{Binding Tutorial}" />
      </TabItem>
      <TabItem Header="地城试炼">
        <Grid Margin="24" ColumnDefinitions="*,*" ColumnSpacing="18">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
              <TextBlock Classes="sectionTitle" Text="地城试炼" />
              <TextBlock Grid.Row="1" Classes="caption" TextWrapping="Wrap"
                         Text="使用当前已在游戏中选定的无限制牌组进行自动对战；不会按牌组名称检查或切换牌组。" />

              <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="7">
                <TextBlock FontWeight="SemiBold" Text="战斗次数" />
                <NumericUpDown Minimum="1"
                               Maximum="99"
                               Increment="1"
                               Value="{Binding DungeonBattleCount}"
                               HorizontalAlignment="Stretch"
                               MinHeight="40" />
                <TextBlock Classes="caption" Text="{Binding DungeonBattleCountText}" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="战斗次数包含首次挑战。失败后仍会再战；连续失败超过 2 次时停止。" />
              </StackPanel>

              <Border Grid.Row="3" Margin="0,18,0,0" Padding="12" Background="#FFF6E5" CornerRadius="7">
                <StackPanel Spacing="7">
                  <TextBlock FontWeight="SemiBold" Foreground="#80601D" Text="启动前检查" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="请将模拟器设为 1280×720 横屏。开始前必须在游戏中提前选定要使用的无限制牌组；当前版本不会检查牌组名称，也不会自动选择或切换牌组。" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="选好牌组后，请停在地城试炼关卡列表。快梦起手有任意 1 费牌时整手保留；没有 1 费牌时交换全部已识别卡牌。" />
                  <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="#80601D"
                             Text="目前支持的无限制牌组码（快梦）" />
                  <TextBox MinHeight="68"
                           IsReadOnly="True"
                           TextWrapping="Wrap"
                           Text="{Binding DungeonRecommendedDeckCode}"
                           ToolTip.Tip="点击文本框后按 Ctrl+A 全选，再按 Ctrl+C 复制" />
                </StackPanel>
              </Border>

              <Button Grid.Row="4" Classes="primary" Command="{Binding DungeonRunCommand}" HorizontalAlignment="Stretch">
                <TextBlock HorizontalAlignment="Center" Text="开始地城试炼" />
              </Button>
              <Button Grid.Row="5" Classes="secondary" Command="{Binding StopCommand}"
                      HorizontalAlignment="Stretch" IsVisible="{Binding IsBusy}">
                <TextBlock HorizontalAlignment="Center" Text="停止运行" />
              </Button>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="sectionTitle" Text="当前首版规则" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="起手有任意 1 费牌时不换牌，否则交换全部；回合开始优先进化场上随从，没有目标时出牌后优先进化疾驰随从；大游戏世界最优先，其他随从优先于法术；敌方有守护时先处理守护，否则攻击主战者。" />
              <Border Height="1" Margin="0,6" Background="#E5E9ED" />
              <TextBlock FontWeight="SemiBold" Text="结算循环" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="胜利会推进完成计数并清零连续失败次数；失败不计数并继续再战。完成目标胜场后点击“返回地城”；连续第 3 次失败或结算状态不明时停止。" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="记牌器">
        <Grid Margin="24">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
              <TextBlock Classes="sectionTitle" Text="己方牌组剩余" />
              <TextBlock Grid.Row="1" Classes="caption"
                         Text="{Binding OwnDeckTotal, StringFormat='共剩余 {0} 张'}" />
              <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding OwnDeckEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold"
                                   Foreground="#2F6F73" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="设置">
        <ScrollViewer>
          <Grid Margin="24" ColumnDefinitions="*,340" ColumnSpacing="18">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Classes="sectionTitle" Text="运行环境" />
                <TextBlock Classes="caption" Text="修改后点击保存；开发环境默认使用项目中的 .venv。" />

                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="项目目录" />
                <TextBox Text="{Binding ProjectRoot}" />

                <TextBlock FontWeight="SemiBold" Text="自动化运行程序（Runner / Python）" />
                <TextBox Text="{Binding PythonPath}" />

                <TextBlock FontWeight="SemiBold" Text="ADB 可执行文件" />
                <TextBox Text="{Binding AdbPath}" />

                <TextBlock FontWeight="SemiBold" Text="设备序列号" />
                <TextBox Text="{Binding DeviceSerial}" />

                <CheckBox IsChecked="{Binding SaveDraw}"
                          Content="保存识别调试图（debug/vision）" />

                <Button Classes="primary" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Content="保存设置" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="sectionTitle" Text="关于" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="MaaSVWB Desktop" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="基于 Avalonia 构建的 MaaFramework 桌面前端。任务逻辑仍由 Python Agent 与资源配置提供。" />
                <Border Height="1" Margin="0,8" Background="#E5E9ED" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="设置保存在当前 Windows 用户的 AppData/Roaming/MaaSVWB/settings.json。" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
