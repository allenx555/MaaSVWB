{
    "interface_version": 2,
    "name": "MaaSVWB",
    "label": "影之诗：超凡世界助手",
    "icon": "./icon.png",
    "description": "基于 MaaFramework 的安卓模拟器教程与盘面解密自动操作工具。",
    "license": "MIT",
    "github": "https://github.com/allenx555/MaaSVWB",
    "welcome": "请将游戏和 MaaFramework 截图输出设为 1280×720。桌面前端会从目录自动显示已录入的解法。",
    "version": "0.1.0",
    "controller": [
        {
            "name": "安卓模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ],
            "controller": [
                "安卓模拟器"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "run_puzzle",
            "label": "运行盘面解密",
            "entry": "执行解法",
            "controller": [
                "安卓模拟器"
            ],
            "resource": [
                "默认资源"
            ],
            "option": [
                "puzzle_solution"
            ]
        },
        {
            "name": "run_tutorial",
            "label": "运行对战教程",
            "entry": "执行解法",
            "controller": [
                "安卓模拟器"
            ],
            "resource": [
                "默认资源"
            ],
            "option": [
                "tutorial_solution"
            ]
        }
    ],
    "option": {
        "puzzle_solution": {
            "type": "select",
            "label": "选择盘面解密",
            "default_case": "puzzle_001",
            "cases": [
                {
                    "name": "puzzle_001",
                    "label": "同时学习【守护】【突进】【疾驰】吧！",
                    "pipeline_override": {
                        "执行解法": {
                            "custom_action_param": {
                                "solution": "puzzle_001"
                            }
                        }
                    }
                },
                {
                    "name": "spec_barbaros_01",
                    "label": "学习巴巴洛丝皇家护卫吧！",
                    "pipeline_override": {
                        "执行解法": {
                            "custom_action_param": {
                                "solution": "spec_barbaros_01"
                            }
                        }
                    }
                },
                {
                    "name": "spec_barbaros_02",
                    "label": "熟练运用巴巴洛丝皇家护卫吧！",
                    "pipeline_override": {
                        "执行解法": {
                            "custom_action_param": {
                                "solution": "spec_barbaros_02"
                            }
                        }
                    }
                },
                {
                    "name": "spec_amulet_bishop_2_01",
                    "label": "学习护符主教吧！",
                    "pipeline_override": {
                        "执行解法": {
                            "custom_action_param": {
                                "solution": "spec_amulet_bishop_2_01"
                            }
                        }
                    }
                },
                {
                    "name": "spec_amulet_bishop_2_02",
                    "label": "熟练运用护符主教吧！",
                    "pipeline_override": {
                        "执行解法": {
                            "custom_action_param": {
                                "solution": "spec_amulet_bishop_2_02"
                            }
                        }
                    }
                }
            ]
        },
        "tutorial_solution": {
            "type": "select",
            "label": "选择对战教程",
            "default_case": "tutorial_spec_latest_barbaros",
            "cases": [
                {
                    "name": "tutorial_spec_latest_barbaros",
                    "label": "巴巴洛丝皇家护卫 · 最新弹",
                    "pipeline_override": {
                        "执行解法": {
                            "custom_action_param": {
                                "solution": "tutorial_spec_latest_barbaros"
                            }
                        }
                    }
                }
            ]
        }
    }
}
